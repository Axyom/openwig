{
  "manifest_version": 2,
  "mod": {
    "id": "openwig-agent",
    "name": "Project: OpenWig Agent",
    "version": "0.1.0-dev.1",
    "author": "Axyom",
    "description": "An agent panel inside Bitwig: chat with Claude Code, which edits the open project through the OpenWig Bridge's MCP server."
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "agent_icon": {
      "kind": "bitwig",
      "path": "icons/chat_view.svg"
    },
    "data": {
      "kind": "directory",
      "path": "agent",
      "persistence": "preserve"
    },
    "ecj": {
      "kind": "file",
      "path": "tools/ecj-3.44.0.jar"
    }
  },
  "registrations": [
    {
      "id": "panels",
      "consumer": "panel-management-framework",
      "descriptor": "panels.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "panel-management-framework",
      "min_version": "0.3.0-dev.8"
    },
    {
      "id": "openwig"
    }
  ]
}
